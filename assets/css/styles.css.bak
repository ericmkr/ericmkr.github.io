/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* ROOT COLORS */
:root {
  --bg: #0f1724;
  --card: #0b1220;
  --muted: #a8b3c5;
  --accent: #ffb347;
  --accent-2: #ff7a59;
  --white: #ffffff;
}

/* BODY */
body {
  font-family: Arial, sans-serif;
  background: #0f1724;
  color: var(--white);
  line-height: 1.5;
}

/* CONTAINER */
.container {
  max-width: 1100px;
  margin: auto;
  padding: 20px;
}

/* HEADER */
.header {
  background: transparent;
}

.header-left {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* LOGO */
.logo img {
  width: 90px;
  height: 90px;
  object-fit: cover;
  border-radius: 10px;
}

/* HEADER RIGHT */
.header-right {
  display: flex;
  align-items: center;
  gap: 15px;
}

/* NAVBAR */
.main-nav {
  background: rgba(0, 0, 0, 0.3);
  padding: 10px 15px;
  border-radius: 10px;
}

/* FIX: NAVBAR SHOULD BE VISIBLE */
.main-nav {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.navbar-nav {
  display: flex;
  list-style: none;
  gap: 20px;
}

.navbar-nav a {
  color: var(--muted);
  text-decoration: none;
  padding: 5px 10px;
}

.navbar-nav a:hover {
  color: var(--accent);
}

/* BUTTON */
.btn-timing {
  padding: 8px 12px;
  border-radius: 6px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: black;
  text-decoration: none;
  font-weight: bold;
}

/* HERO */
.hero {
  text-align: center;
  padding: 50px 0;
}

.hero-img {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  margin-bottom: 15px;
}

/* HEADINGS */
h1 {
  font-size: 2rem;
  margin-bottom: 10px;
}

h2 {
  text-align: center;
  margin: 30px 0;
}

/* GRID */
.grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

/* CARD */
.card {
  background: rgba(255, 255, 255, 0.05);
  padding: 15px;
  border-radius: 10px;
  text-align: center;
}

.card img {
  width: 100%;
  border-radius: 8px;
  margin-bottom: 10px;
}

/* FOOTER */
.site-footer {
  background: rgba(0, 0, 0, 0.3);
  padding: 30px;
  text-align: center;
}

footer input,
footer textarea {
  width: 100%;
  padding: 10px;
  margin: 5px 0;
  border-radius: 5px;
  border: none;
}

footer button {
  margin-top: 10px;
}

/* RESPONSIVE */
@media (max-width: 768px) {
  .header-left {
    flex-direction: column;
    gap: 10px;
  }

  .navbar-nav {
    flex-direction: column;
    align-items: center;
  }

  .grid {
    grid-template-columns: 1fr;
  }
}